{
  "model": "sonnet",
  "effortLevel": "medium",
  "autoCompactWindow": 200000,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/economia/statusline.sh"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/economia/modo.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/economia/ler.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/economia/aparar.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
